<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Barra" parent="android:Widget.Material.Toolbar">
        <item name="android:background">@color/superficie</item>
        <item name="android:titleTextAppearance">@style/Texto.TituloBarra</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:contentInsetStart">16dp</item>
    </style>
    <style name="Menu" parent="android:Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/fondo_menu</item>
    </style>
    <style name="Texto.TituloBarra" parent="android:TextAppearance.Material.Widget.Toolbar.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/sobre_superficie</item>
    </style>

    <style name="Boton" parent="android:Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="Boton.Lleno">
        <item name="android:background">@drawable/boton_lleno</item>
        <item name="android:textColor">@color/sobre_primario</item>
    </style>
    <style name="Boton.Tonal">
        <item name="android:background">@drawable/boton_tonal</item>
        <item name="android:textColor">@color/sobre_secundario_cont</item>
    </style>
    <style name="Boton.Contorno">
        <item name="android:background">@drawable/boton_contorno</item>
        <item name="android:textColor">@color/primario</item>
    </style>
    <style name="Boton.Peligro">
        <item name="android:background">@drawable/boton_contorno</item>
        <item name="android:textColor">@color/error</item>
    </style>

    <style name="Campo" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/campo</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/sobre_superficie</item>
        <item name="android:textColorHint">@color/sobre_superficie_var</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/chip</item>
        <item name="android:textColor">@color/chip_texto</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Etiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/primario</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Tarjeta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/tarjeta</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
</resources>
