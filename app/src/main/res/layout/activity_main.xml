<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/aviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/aviso_fondo"
        android:padding="12dp"
        android:text="@string/sin_numero"
        android:textColor="@color/aviso_texto"
        android:visibility="gone" />

    <RadioGroup
        android:id="@+id/filtro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <RadioButton
            android:id="@+id/f_todas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="@string/todas" />

        <RadioButton
            android:id="@+id/f_pendientes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pendientes" />

        <RadioButton
            android:id="@+id/f_enviadas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/enviadas" />
    </RadioGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/grilla"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:choiceMode="multipleChoiceModal"
            android:clipToPadding="false"
            android:columnWidth="160dp"
            android:horizontalSpacing="6dp"
            android:numColumns="auto_fit"
            android:padding="6dp"
            android:stretchMode="columnWidth"
            android:verticalSpacing="6dp" />

        <TextView
            android:id="@+id/vacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/vacio"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/btn_foto"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_margin="8dp"
        android:backgroundTint="@color/naranja"
        android:text="@string/sacar_foto"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />
</LinearLayout>
