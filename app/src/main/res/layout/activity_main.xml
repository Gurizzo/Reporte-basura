<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Toolbar
            android:id="@+id/barra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <RadioGroup
                android:id="@+id/filtro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <RadioButton
                    android:id="@+id/f_todas"
                    style="@style/Chip"
                    android:checked="true"
                    android:text="@string/todas" />

                <RadioButton
                    android:id="@+id/f_pendientes"
                    style="@style/Chip"
                    android:text="@string/pendientes" />

                <RadioButton
                    android:id="@+id/f_enviadas"
                    style="@style/Chip"
                    android:text="@string/enviadas" />
            </RadioGroup>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <GridView
                android:id="@+id/grilla"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:choiceMode="multipleChoiceModal"
                android:clipToPadding="false"
                android:columnWidth="160dp"
                android:horizontalSpacing="10dp"
                android:listSelector="@android:color/transparent"
                android:numColumns="auto_fit"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="104dp"
                android:stretchMode="columnWidth"
                android:verticalSpacing="10dp" />

            <TextView
                android:id="@+id/vacio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingBottom="80dp"
                android:text="@string/vacio"
                android:textColor="@color/sobre_superficie_var"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_foto"
        style="@style/Boton"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="@drawable/boton_fab"
        android:drawableStart="@drawable/ic_camara"
        android:drawablePadding="12dp"
        android:elevation="6dp"
        android:paddingStart="20dp"
        android:paddingEnd="24dp"
        android:text="@string/sacar_foto"
        android:textColor="@color/sobre_fab"
        android:textSize="16sp" />
</FrameLayout>
