<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <Toolbar
        android:id="@+id/barra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <uy.reportebasura.Redondeado
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/celda">

                <ImageView
                    android:id="@+id/img"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:maxHeight="480dp"
                    android:minHeight="200dp"
                    android:scaleType="fitCenter" />
            </uy.reportebasura.Redondeado>

            <LinearLayout
                style="@style/Tarjeta"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/dir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/sobre_superficie"
                    android:textIsSelectable="true"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/datos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/sobre_superficie_var"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_enviar"
                style="@style/Boton.Lleno"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/enviar_whatsapp" />

            <Button
                android:id="@+id/btn_estado"
                style="@style/Boton.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_editar"
                    style="@style/Boton.Contorno"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/editar_direccion" />

                <Button
                    android:id="@+id/btn_mapa"
                    style="@style/Boton.Contorno"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/ver_mapa" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_regeo"
                style="@style/Boton.Contorno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/buscar_direccion" />

            <Button
                android:id="@+id/btn_borrar"
                style="@style/Boton.Peligro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/borrar" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
